{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHircQ",
  "version": "0.6.0",
  "identifier": "org.enterthefield.phircq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3690",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PHircQ",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
